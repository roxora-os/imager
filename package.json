    "@patternfly/react-table": "6.7.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.2.3",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.12",
    "playwright-core": "1.64.1",
    "react": "19.2.0",
