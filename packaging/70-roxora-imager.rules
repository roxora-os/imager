# Rockchip boards in Maskrom or Loader mode (USB vendor 2207): give the
# logged-in desktop user access, so Roxora Imager can write them without
# root. "uaccess" needs systemd-logind and must sort before
# 73-seat-late.rules. Same rule as RKDevelopTool-GUI's.
SUBSYSTEM=="usb", ATTR{idVendor}=="2207", TAG+="uaccess"
